rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper: Valid Event
    function isValidEvent(data) {
      return data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.courtsCount is number && data.courtsCount > 0 && data.courtsCount <= 50 &&
        data.status in ['active', 'completed', 'draft'];
    }

    // Helper: Valid Player
    function isValidPlayer(data) {
      return data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    // Helper: Valid Participant
    function isValidParticipant(data) {
      return data.id is string && isValidId(data.id) &&
        data.eventId is string && isValidId(data.eventId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.status in ['available', 'playing', 'waiting', 'unavailable'];
    }

    // Helper: Valid Match
    function isValidMatch(data) {
      return data.id is string && isValidId(data.id) &&
        data.eventId is string && isValidId(data.eventId) &&
        data.courtId is string && data.courtId.size() > 0 && data.courtId.size() <= 64 &&
        data.score1 is number && data.score1 >= 0 &&
        data.score2 is number && data.score2 >= 0 &&
        data.status in ['waiting', 'live', 'completed'];
    }

    // Helper: Valid Switch
    function isValidSwitch(data) {
      return data.id is string && isValidId(data.id) &&
        data.eventId is string && isValidId(data.eventId) &&
        data.matchId is string && isValidId(data.matchId) &&
        data.timestamp is string;
    }

    // Events collection
    match /events/{eventId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming());
      allow update: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isSignedIn() && isValidId(eventId);

      // Event Participants subcollection
      match /participants/{participantId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(participantId) && isValidParticipant(incoming());
        allow update: if isSignedIn() && isValidId(participantId) && isValidParticipant(incoming());
        allow delete: if isSignedIn() && isValidId(participantId);
      }

      // Event Matches subcollection
      match /matches/{matchId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming());
        allow update: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming());
        allow delete: if isSignedIn() && isValidId(matchId);
      }

      // Event Switches subcollection
      match /switches/{switchId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(switchId) && isValidSwitch(incoming());
        allow update: if isSignedIn() && isValidId(switchId) && isValidSwitch(incoming());
        allow delete: if isSignedIn() && isValidId(switchId);
      }
    }

    // Master Players collection
    match /players/{playerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(playerId) && isValidPlayer(incoming());
      allow update: if isSignedIn() && isValidId(playerId) && isValidPlayer(incoming());
      allow delete: if isSignedIn() && isValidId(playerId);
    }

    // Test connection document for verifying Firestore connectivity
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
